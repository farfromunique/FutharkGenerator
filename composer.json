{
    "name": "acwpd/futhark-generator",
    "description": "This is a PHP fork of the Futhark generator for Worm.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "PHP": "^7.2 || ^8.0",
        "kreait/firebase-php": "^6.1",
        "slim/slim": "^3.12",
        "slim/php-view": "^2.2",
        "monolog/monolog": "^1.24",
        "symfony/dotenv": "^5.4",
        "aws/aws-sdk-php": "^3.210"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0",
        "vlucas/phpdotenv": "^3.6",
        "heroku/heroku-buildpack-php": "^162.0",
        "squizlabs/php_codesniffer": "*"
    },
    "authors": [{
        "name": "Aaron C",
        "email": "git@acwpd.com"
    }],
    "config": {
        "vendor-dir": "protected/vendor"
    },
    "autoload": {
        "psr-4": {
            "ACWPD\\Futhark\\": "protected/classes/",
            "ACWPD\\Helpers\\": "protected/classes/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public/",
        "check-test": "aws dynamodb get-item --table-name futhark_save_data --key file://testsavekey.json",
        "reset-test": "aws dynamodb put-item --table-name futhark_save_data --item file://testsave_reset.json",
        "nginx-serve-80": "sudo service php8.0-fpm start && sudo service nginx start"
    }
}
